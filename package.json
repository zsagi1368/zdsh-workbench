{
  "name": "zdsh-workbench",
  "version": "0.1.0-beta.1",
  "description": "zDSH Workbench: an IDE-grade dock workspace for DSH (deepseek-harness) - files / editor / terminal / git / tasks / browse / side chat, plus a service registry other plugins can extend. Clean-room independent development.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zsagi1368/zdsh-workbench.git"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "compatible": ">=0.1.5-rc.2 <0.2.0",
    "autoApprove": true,
    "capabilities": [
      {
        "type": "service",
        "service": {
          "name": "zdsh-workbench/server",
          "factory": "./lib/index.js",
          "singleton": true
        }
      }
    ],
    "sandbox": {
      "type": "inline",
      "resources": { "memoryLimitMb": 512, "cpuLimit": 50, "timeoutMs": 300000, "maxOutputBytes": 1000000 },
      "filesystem": { "access": "readwrite", "allowedPaths": [], "deniedPatterns": [] },
      "network": { "access": "external", "allowedHosts": [], "deniedHosts": [], "allowLocal": true },
      "environment": { "whitelist": [], "blacklist": [], "clear": false },
      "process": {
        "spawn": true,
        "exec": false,
        "allowedCommands": ["git", "where.exe", "pwsh.exe", "powershell.exe", "cmd.exe", "bash"]
      }
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && tsdown",
    "typecheck": "tsc --noEmit",
    "bundle": "tsdown",
    "watch": "tsdown --watch",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-locale": "=0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "=0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "=0.2.0-rc.2",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^24.13.3",
    "@types/react": "~18.3.31",
    "@types/react-dom": "~18.3.1",
    "@types/ws": "^8.18.1",
    "@xterm/xterm": "^5.5.0",
    "jsdom": "^29.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.6.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "node-pty": "1.2.0-beta.15",
    "ws": "^8.21.3"
  }
}
